<style>
/* Quiet, theme-preserving motion for portfolio pages. */
@media (prefers-reduced-motion: no-preference) {
  article { animation: motion-page-in 420ms ease-out both; }
  .nav-link { transition: opacity 180ms ease, transform 180ms ease; }
  .nav-link:hover { transform: translateY(-1px); }
  .nav-link.active, .nav-link[aria-current="page"] { text-underline-offset: 0.24em; }
  .project-row { transition: transform 220ms ease, box-shadow 220ms ease; border-radius: 0.5rem; }
  .project-row:hover { transform: translateY(-3px); box-shadow: 0 10px 26px rgba(0, 0, 0, 0.08); }
  .links a, article a { transition: text-decoration-color 180ms ease, opacity 180ms ease; }
  .links a:hover, article a:hover { opacity: 0.82; }
  .motion-reveal { opacity: 0; transform: translateY(12px); transition: opacity 520ms ease, transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .motion-reveal.motion-visible { opacity: 1; transform: translateY(0); }
}
@keyframes motion-page-in { from { opacity: 0.65; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) {
  article, .nav-link, .project-row, article a { animation: none !important; transition: none !important; transform: none !important; }
}
</style>
<script>
(() => {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const reveal = () => {
    const targets = document.querySelectorAll('article .profile, article h2, article h3, article p, article .project-row, article table, article li');
    if (!targets.length) return;
    targets.forEach((el, index) => {
      el.classList.add('motion-reveal');
      el.style.transitionDelay = (Math.min(index % 5, 4) * 55) + 'ms';
    });
    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('motion-visible'); obs.unobserve(entry.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -24px 0px' });
    targets.forEach(el => observer.observe(el));
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', reveal, { once: true });
  else reveal();
})();
</script>
